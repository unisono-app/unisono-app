# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Login (server only)
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret

# Supabase CLI (ローカル開発用、デプロイには不要)
SUPABASE_DB_PASSWORD=your-db-password

# 【暫定】ユーザー受け入れ期間中、承認時に既存の全楽曲へ担当パートを自動登録する。
# "true" で有効。受け入れ期間終了後は削除（または true 以外）にする。
BACKFILL_ON_APPROVE=true

# お知らせバナー（開発者からのユーザー向けメッセージ）。ヘッダー直下に帯で表示。
# 文言をセットすると表示、空/未設定で非表示。変更は再デプロイで反映される。
# ANNOUNCEMENT_LEVEL は "warning" で警告色、それ以外/未設定で情報色。
ANNOUNCEMENT_MESSAGE=
ANNOUNCEMENT_LEVEL=
